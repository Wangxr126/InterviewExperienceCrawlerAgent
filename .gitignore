# ============================================================
# 面经 Agent 项目 .gitignore
# ============================================================

# ━━━ 环境与密钥（含 API Key / Token，禁止提交）━━━
.env
.env.local
.env.*.local
.env.development
.env.production
*.pem
*.key
CREDENTIALS.md
*credentials*
*secrets*
**/secrets/

# ━━━ 后端数据（不提交到仓库）━━━
backend/data/
backend/logs/
# 面试官 Agent 运行时日志（chat/thinking/tools 的 jsonl）
backend/interviewer_logs/
backend/*.db
*.db
*.db-journal
*.db-wal

# 根目录遗留数据目录（已迁移至 backend/data，若存在可删除）
memory/
memory_data/
tool-output/
sqlite/
neo4j_data/
xhs_user_data/
qdrant_storage/
test_nowcoder_output/

# 本地参考与思路（不上传）
参考项目/
思路/
# 微调流水线 LLM 日志（jsonl）
微调/llm_logs/
# ━━━ 前端构建与依赖 ━━━
node_modules/
frontend/dist/
web/node_modules/
web/dist/
backend/static/dist/

# ━━━ Python ━━━
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
*.egg

# ━━━ 虚拟环境 ━━━
.venv/
venv/
ENV/

# ━━━ IDE 与编辑器 ━━━
.idea/
.vscode/
.claude/
*.swp
*.swo

# ━━━ 调试与临时文件 ━━━
*.log
*.log.*
*.tmp
debug_*.txt
debug_*.html
*_stderr.log
*_stdout.log
uvicorn_*.txt
xhs_link_cache.txt
# 根目录或子目录里散落的运行日志
logs/
**/logs/*.log

# 前端 / Node 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
web/*.log

# 临时脚本和归档
scripts/temp/
docs/archive/

# ━━━ HelloAgents 源码（项目使用 pip 安装的 hello-agents 包）━━━
HelloAgents/
HelloAgents-1.0.0/

# ━━━ PAI-DSW 本机打包产物（可重复生成）━━━
微调/dsw/finetune_dsw_bundle.zip
微调/dsw/_pack_staging/
微调/.venv_finetune/

# ━━━ 系统文件 ━━━
.DS_Store
Thumbs.db


