{
  "base_model": "qwen3:4b",
  "method": "qlora",
  "output_name": "qwen3-4b-miner-lora",
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lora_target_modules": "q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj",
  "learning_rate": 0.0002,
  "num_epochs": 3,
  "per_device_train_batch_size": 2,
  "gradient_accumulation_steps": 8,
  "max_seq_length": 4096,
  "warmup_ratio": 0.1,
  "weight_decay": 0.01,
  "use_rslora": true,
  "precision": "bf16"
}