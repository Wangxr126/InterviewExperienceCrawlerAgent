# 13. OCR（帖内图）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# OCR_METHOD：remote | ollama_vl | qwen_vl | claude_vision | mcp
#
OCR_METHOD=remote
OCR_REMOTE_API_KEY=your_volcengine_ark_api_key_here
OCR_REMOTE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OCR_REMOTE_MODELS=[{"model":"doubao-1-5-vision-pro-32k-250115"}]
