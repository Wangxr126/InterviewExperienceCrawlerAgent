# ============================================================
# 面经 Agent — 环境变量模板
#
# 使用：复制为 .env 并填写真实值
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# 请勿将 .env 提交到 Git（已在 .gitignore）
# 说明：下列值为占位符；布尔值常用 true/false 或 1/0
# ============================================================


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 1. 全局 LLM（各 Agent 未单独指定时的默认）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# LLM_MODE：local（Ollama）| remote（云端 OpenAI 兼容）
#
LLM_MODE=local

# --- 1.1 本地 Ollama ---
LLM_LOCAL_PROVIDER=ollama
LLM_LOCAL_MODEL=qwen3:4b
LLM_LOCAL_API_KEY=ollama
LLM_LOCAL_BASE_URL=http://localhost:11434/v1
LLM_LOCAL_TIMEOUT=180

# --- 1.2 远程云端 ---
LLM_REMOTE_PROVIDER=volcengine
LLM_REMOTE_MODEL=your_model_id
LLM_REMOTE_API_KEY=your_api_key_here
LLM_REMOTE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_REMOTE_TIMEOUT=300

# --- 1.3 通用 ---
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# 启动时预热本地 Ollama 模型（默认 true）
# LLM_WARMUP_ENABLED=true

# 设为 false 可跳过 Embedding / Rerank / OCR 预热（仅题目提取场景可加快启动）
# WARMUP_EMBEDDING_RERANK_OCR=true

# Ollama 常驻显存：启动前设 OLLAMA_KEEP_ALIVE=-1（Windows 可用 run_ollama.bat）


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 2. 各 Agent 覆盖项（留空则继承 §1 全局 LLM）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━


# ────────────────────────────────────────────────────────────
# 2.1 Knowledge Manager（知识管理器）
# ────────────────────────────────────────────────────────────
#
# ARCHITECT_MODE：local | remote（留空 = LLM_MODE）
#
ARCHITECT_MODE=local
KNOWLEDGE_MANAGER_TEMPERATURE=0.2
KNOWLEDGE_MANAGER_MAX_TOKENS=


# ────────────────────────────────────────────────────────────
# 2.2 Interviewer（面试官）
# ────────────────────────────────────────────────────────────
#
# INTERVIEWER_MODE：local | remote（留空 = LLM_MODE）
#
INTERVIEWER_MODE=local

INTERVIEWER_LOCAL_PROVIDER=ollama
INTERVIEWER_LOCAL_MODEL=qwen3:4b
INTERVIEWER_LOCAL_BASE_URL=http://localhost:11434/v1
INTERVIEWER_LOCAL_TIMEOUT=180

INTERVIEWER_REMOTE_PROVIDER=
# DeepSeek 官方：deepseek-chat / deepseek-reasoner，勿填展示名如 DeepSeek-V3.2
INTERVIEWER_REMOTE_MODEL=
INTERVIEWER_REMOTE_BASE_URL=
INTERVIEWER_REMOTE_TIMEOUT=
INTERVIEWER_REMOTE_API_KEY=your_api_key_here

INTERVIEWER_TEMPERATURE=0.5
# INTERVIEWER_HISTORY_MAX_MESSAGES=20
INTERVIEWER_MAX_TOKENS=
INTERVIEWER_MAX_STEPS=20
INTERVIEWER_TIMEOUT=180

# 聊天 SSE：true=流式 token；false=整轮完成后一次性下发
# INTERVIEWER_STREAMABLE=true


# ────────────────────────────────────────────────────────────
# 2.3 Miner（题目提取 / 信息挖掘）
# ────────────────────────────────────────────────────────────
#
# MINER_MODE：
#   local      — 单阶段，仅用 MINER_LOCAL_*
#   remote     — 单阶段，仅用 MINER_REMOTE_*
#   two_stage  — Stage1 粗提取 + Stage2 精加工（见下）
#
MINER_MODE=two_stage


# ========== two_stage：Stage1（粗提取）==========
# MINER_STAGE1_MODE：local | remote（未写则默认 remote）
#
MINER_STAGE1_MODE=remote

# --- Stage1 = local 时（与下面 MINER_LOCAL_* 二选一；可只配 MINER_LOCAL_* 回退）---
# MINER_STAGE1_LOCAL_MODEL=qwen3:4b
# MINER_STAGE1_LOCAL_BASE_URL=http://localhost:11434/v1
# MINER_STAGE1_LOCAL_API_KEY=
# MINER_STAGE1_LOCAL_TIMEOUT=180

# --- Stage1 = remote 时：主端点（未填则回退 MINER_REMOTE_*）---
# MINER_STAGE1_REMOTE_MODEL=qwen3-4b
# MINER_STAGE1_REMOTE_API_KEY=your_key
# MINER_STAGE1_REMOTE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# MINER_STAGE1_REMOTE_TIMEOUT=180

# Stage1 远程备用链（401/限流等自动换下一项；单行 JSON，勿换行）
# MINER_STAGE1_FALLBACK_MODELS=[{"model":"qwen-turbo","api_key":"key2","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1"}]


# ========== Miner：单阶段默认值 / two_stage 回退 ==========
# local 单阶段或 Stage1 未单独配置时的本地默认
MINER_LOCAL_PROVIDER=ollama
MINER_LOCAL_MODEL=qwen3:4b
MINER_LOCAL_BASE_URL=http://localhost:11434/v1
MINER_LOCAL_TIMEOUT=180

# remote 单阶段或 Stage1 未单独配置时的远程默认（须支持 Function Calling）
MINER_REMOTE_PROVIDER=volcengine
MINER_REMOTE_MODEL=qwen3-4b
MINER_REMOTE_API_KEY=your_ark_api_key
MINER_REMOTE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MINER_REMOTE_TIMEOUT=180

# 通义等：非流式工具调用需关闭思考链（默认在 extra_body 中带 enable_thinking=false）
# MINER_REMOTE_ENABLE_THINKING=false
# MINER_REMOTE_MAX_TOKENS=16384
# MINER_STAGE1_API_MAX_TOKENS=8192
# MINER_REMOTE_EXTRA_BODY_JSON=

MINER_TEMPERATURE=0
MINER_MAX_TOKENS=32768
MINER_MAX_STEPS=100
MINER_MAX_RETRIES=3
# MINER_REFUSAL_RETRIES=3
# MINER_ENFORCE_CHINESE_OUTPUT=true

# ReAct 日志中用户输入：0=不截断、完整写入 INFO（默认）；>0 仅前 N 字并加省略号（如 400=旧行为）
# MINER_LOG_INPUT_PREVIEW_CHARS=0

# process_tasks 子进程：OpenAI SDK 自动重试时默认只打「Retrying request」不含 HTTP 原因；设为 1 打开 httpx/httpcore DEBUG
# OPENAI_SDK_VERBOSE=0


# ========== two_stage：Stage2（精加工，通常为豆包 / Ark）==========
# MINER_STAGE2_MODEL=doubao-1-5-pro-32k-250115
# MINER_STAGE2_API_KEY=your_volcengine_api_key
# MINER_STAGE2_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# MINER_STAGE2_MAX_TOKENS=8192
# MINER_STAGE2_MAX_TOKENS_CAP=12288
# MINER_STAGE2_TIMEOUT=300

# Stage2 备用（额度问题按序切换；单行 JSON）
# MINER_STAGE2_FALLBACK_MODELS=[{"model":"xxx","api_key":"yyy","base_url":"https://..."}]

# Stage2 异步队列（达 batch_size 触发批量）
# MINER_STAGE2_ASYNC_ENABLED=true
# MINER_STAGE2_BATCH_SIZE=10
# MINER_STAGE2_USE_BATCH=false
# MINER_STAGE2_RUN_MODE=process


# 两阶段对比日志（微调用 JSONL，可选）
# MINER_TWO_STAGE_LOG=./微调/llm_logs/miner_two_stage_log.jsonl


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 3. Embedding（MemoryTool 向量）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# EMBED_MODEL_TYPE：ollama | dashscope
#
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v4
EMBED_API_KEY=your_dashscope_api_key_here
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBED_OLLAMA_URL=http://localhost:11434
# EMBED_TIMEOUT=120


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 3.5 检索与重排（RAG）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# RERANK_MODE：remote（DashScope compatible-api）| ollama
#
RERANK_ENABLED=true
RERANK_MODE=remote
RERANK_MODEL=qwen3-rerank
# RERANK_API_KEY=
RERANK_REMOTE_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
# RERANK_INSTRUCT=Retrieve semantically similar text.
RERANK_OLLAMA_URL=http://localhost:11434
RERANK_TOP_N=5
RERANK_MAX_DOC_LENGTH=1024
RERANK_TIMEOUT=60

RETRIEVAL_SEARCH_TOP_K=15
RETRIEVAL_SCORE_THRESHOLD=0.5
RETRIEVAL_SIMILAR_LIMIT=5
RETRIEVAL_CHECK_DUPLICATE_THRESHOLD=0.92

SMART_PRACTICE_KNOWLEDGE_GAP_COUNT=10
SMART_PRACTICE_RANDOM_COUNT=10
SMART_PRACTICE_RECALL_RATIO=3
SMART_PRACTICE_RERANK_ENABLED=true
SMART_PRACTICE_VECTOR_WEIGHT=0.35
SMART_PRACTICE_REVIEW_WEIGHT=0.45
SMART_PRACTICE_POPULAR_WEIGHT=0.2
SMART_PRACTICE_WEAK_TAGS_LIMIT=5


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 4. Neo4j
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 5. Qdrant
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hello_agents_vectors


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 6. 本地路径（相对项目根）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SQLITE_DB_PATH=./backend/data/local_data.db
MEMORY_DATA_DIR=./backend/data/memory
LOG_DIR=./backend/logs
XHS_USER_DATA_DIR=./backend/data/xhs_user_data
LLM_PROMPT_LOG_CSV=./微调/llm_logs/llm_prompt_log.jsonl
FINETUNE_LOGS_DIR=./微调/llm_logs


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 6.5 正文抓取来源
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# CRAWLER_SOURCE：local | mcp
#
CRAWLER_SOURCE=local
MCP_CONTENT_FETCHER_URL=https://mcp-content-fetcher.onrender.com
MCP_CONTENT_FETCHER_TIMEOUT=30
# SMITHERY_API_KEY=


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 7. 牛客爬虫
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
NOWCODER_COOKIE=
NOWCODER_KEYWORDS=agent面经
NOWCODER_MAX_PAGES=2


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 8. 小红书爬虫
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
XHS_KEYWORDS=agent面经
XHS_MAX_NOTES_PER_KEYWORD=5
XHS_LOGIN_WAIT_SECONDS=120


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 9. 爬虫重试
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
CRAWLER_FETCH_MAX_RETRIES=3
CRAWLER_RETRY_DELAY=5
CRAWLER_RECURSIVE_RETRY_MAX=10


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 10. 微调页辅助 LLM
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
FINETUNE_LLM_PROVIDER=volcengine
FINETUNE_LLM_MODEL=your_model_id
FINETUNE_LLM_API_KEY=your_api_key_here
FINETUNE_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
FINETUNE_LLM_TEMPERATURE=0.2
FINETUNE_LLM_TIMEOUT=180


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 11. 定时调度
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SCHEDULER_ENABLE_NOWCODER=true
SCHEDULER_NOWCODER_HOURS=2,14
SCHEDULER_ENABLE_XHS=true
SCHEDULER_PROCESS_MINUTE=0

CRAWLER_PROCESS_BATCH_SIZE=100
# CRAWLER_PROCESS_BATCH_MAX=200
# process = 子进程批量提取（默认）；thread = 调试同步跑满一批
CRAWLER_BACKGROUND_RUN_MODE=process
# 重启后是否自动恢复未完成的 fetch / batch_extract
# CRAWLER_AUTO_RESUME_FETCHED_ON_STARTUP=true
# CRAWLER_AUTO_RESUME_BATCH_EXTRACT_ON_STARTUP=true


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 12. 默认用户与对话 Agent
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DEFAULT_USER_ID=dev_user
DEFAULT_SESSION_ID=sess_fixed
INTERVIEWER_MAX_STEPS=100


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 12.5 题目推荐（GetRecommendedQuestionTool）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
RECOMMEND_QUESTIONS_COUNT=5
RECOMMEND_QUESTIONS_JSON_FORMAT=true
RECOMMEND_QUESTIONS_SHOW_DETAIL=true
RECOMMEND_QUESTIONS_SHOW_REASON=true


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 13. OCR（帖内图）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# OCR_METHOD：remote | ollama_vl | qwen_vl | claude_vision | mcp
#
OCR_METHOD=remote
OCR_REMOTE_API_KEY=your_volcengine_ark_api_key_here
OCR_REMOTE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
